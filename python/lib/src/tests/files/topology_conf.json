{    
    "product": {
        "name": "Saphir",
        "splash_bgcolor": "#3a414d"
    },
    "usb": {
        "use": 1
    },
    "screen": {
        "enabled": 1,
        "default_focus": "controller"
    },
    "vcpu": {
        "groups": {
            "sys-gui": 0.2,
            "antivirus": 0.8
        }
    },
    "network": {
        "repository": "https://www.alefbet.net/github/saphir"
    },
    "business": {    
        "domains": [
            {
                "name": "saphir-av-clamav",
                "app-package": "saphir-av-clamav",
                "memory": 3000,
                "vcpu_group": "antivirus"
            },
            {
                "name": "saphir-av-eset",
                "app-package": "saphir-av-eset",
                "memory": 1500,
                "vcpu_group": "antivirus"
            },
            {
                "name": "controller",
                "app-package": "app-controller",
                "memory": 1000,
                "vcpu_group": "sys-gui",
