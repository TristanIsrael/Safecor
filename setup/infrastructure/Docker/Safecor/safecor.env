# The local subnet of the infrastructure
IP_SUBNET=192.168.10.0

# The netmask of the subnet
IP_NETMASK=24

# The DHCP server IPv4 address
DHCP_SERVER_IP=192.168.10.1

# The TFTP server IPv4 address
TFTP_SERVER_IP=192.168.10.2

# The repository server IPv4 address
REPOSITORY_SERVER_IP=192.168.10.3

# The external port of the HTTP server for the repository container
REPOSITORY_WEB_PORT=80

# The DHCP admin web tool external port 
DHCP_WEB_PORT=8080

# The DHCP range first address that will be attributed to clients in PXE boot
DHCP_RANGE_BEGIN=192.168.10.10

# The DHCP range last address that will be attributed to clients in PXE boot
DHCP_RANGE_END=192.168.10.200

# The Alpine version to use when installing the servers of the infrastructure
ALPINE_VERSION=3.23

# The local path of the repository (containing Alpine, and other packages)
# This path will be used to setup the servers of the infrastructure
LOCAL_REPOSITORY_PATH=/Users/tristanisrael/Documents/Depots

# Unused?
NIC_NAME=en0

