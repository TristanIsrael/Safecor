#!/bin/sh

logger -t "Safecor/sys-usb/safecor-sys-usb-post-install" -p user.debug "Package safecor-sys-usb post-install"

# Fail on error
set -e

# Free memory
mount -o remount,size=2M /dev/shm
logger -t "Safecor/sys-usb/safecor-sys-usb-post-install" -p user.debug "Resized shared memory"

# Prepare the file system
mkdir -p /var/log/safecor
mkdir -p /media/loop
chmod 770 /media/loop
logger -t "Safecor/sys-usb/safecor-sys-usb-post-install" -p user.debug "File system prepared"

# Load kernel modules for filesystems
modprobe exfat
modprobe vfat
modprobe ntfs3
modprobe ext4
modprobe fuse
logger -t "Safecor/sys-usb/safecor-sys-usb-post-install" -p user.debug "Removed unused kernel modules"

# Create accounts and handle permissions
addgroup -g 2000 safecor
adduser -H -D -s /sbin/nologin -G safecor svc-sys-usb-controller
adduser -H -D -s /sbin/nologin -G safecor svc-tty-tunnel
addgroup svc-sys-usb-controller input
addgroup svc-tty-tunnel dialout
addgroup svc-tty-tunnel tty
chgrp safecor /media/loop
chgrp safecor /dev/hvc*
logger -t "Safecor/sys-usb/safecor-sys-usb-post-install" -p user.debug "Service accounts created"

# Start Safecor USB controller
rc-update add safecor-sys-usb-controller
rc-service safecor-sys-usb-controller star
logger -t "Safecor/sys-usb/safecor-sys-usb-post-install" -p user.debug "Start sys-usb controller"

# Manage udev
rc-update add udev boot
rc-service udev start
udevadm control --reload-rules
udevadm trigger
logger -t "Safecor/sys-usb/safecor-sys-usb-post-install" -p user.debug "Udev service started"

# Call hardening script
/usr/lib/safecor/bin/hardening.sh
logger -t "Safecor/sys-usb/safecor-sys-usb-post-install" -p user.debug "Hardening done"

# Optimize the kernel RAM usage for 9P performance and stability
sysctl vm.vfs_cache_pressure=200
sysctl vm.compaction_proactiveness=100
sysctl vm.min_free_kbytes=102400
logger -t "Safecor/sys-usb/safecor-sys-usb-post-install" -p user.debug "Kernel RAM usage optimized for 9p"

exit 0