#!/sbin/openrc-run
# Copyright (c) 2024-2026, Tristan Israël
# Safecor Licence — see python/lib/LICENCE.md


name="safecor-sys-usb-controller"

depend() {
    after setup-vchan
    before udev
}

start() {
    ebegin "Starting Safecor sys-usb controller"

    # Runtime files of the direct mount SFTP channels (the UNIX socket,
    # the pidfiles, the per-domain log and the sandbox passwd of every
    # channel). /var/run is a tmpfs, so the directory is created at every
    # boot; the controller user owns it (it reads and writes these files).
    mkdir -p /var/run/safecor/direct-mount
    chown svc-sys-usb-controller:safecor /var/run/safecor/direct-mount
    chmod 770 /var/run/safecor/direct-mount

    # Local persistent log for direct mount channel lifecycle events
    # (see docs/architecture/components/direct-usb-mount.md).
    # The initd runs as root; the controller runs as svc-sys-usb-controller.
    mkdir -p /var/log/safecor
    [ -f /var/log/safecor/direct-mount.log ] || touch /var/log/safecor/direct-mount.log
    chown svc-sys-usb-controller:safecor /var/log/safecor/direct-mount.log
    chmod 660 /var/log/safecor/direct-mount.log

    start-stop-daemon --start --make-pidfile --exec /usr/bin/python3 --umask 0007 --pidfile /var/run/$name.pid --background --user svc-sys-usb-controller -- /usr/lib/safecor/bin/safecor-sys-usb-controller.py

    eend $?
}

stop() {
    ebegin "Stopping Safecor sys-usb controller"

    kill -9 $(cat /var/run/$name.pid)

    eend $?
}
