#!/sbin/openrc-run
# Start the per-DomU vchan+SFTP channels on sys-usb for direct USB mount.
#
# The logic lives in /usr/lib/safecor/bin/safecor-vchan-sftp.py, which is
# started detached so that the boot is never blocked (the topology query
# needs MQTT, which may not be available right after boot).
#
# Copyright (c) 2024-2026, Tristan Israël
# Safecor Licence — see python/lib/LICENCE.md

name="safecor-vchan-sftp"
pidfile="/var/run/safecor/vchan-sftp.pid"
user="root"
group="safecor"
logfile="/var/log/safecor/vchan-sftp.log"

depend() {
    after bootlocal
    after setup-vchan
}

start() {
    ebegin "Starting vchan SFTP channels"
    modprobe xen_gntdev
    modprobe xen_gntalloc
    modprobe xen_evtchn
    mkdir -p /var/run/safecor
    start-stop-daemon --start --background --make-pidfile \
        --pidfile "$pidfile" \
        --stdout "$logfile" --stderr "$logfile" \
        --exec /usr/bin/python3 \
        -- /usr/lib/safecor/bin/safecor-vchan-sftp.py
    eend $?
}

stop() {
    ebegin "Stopping vchan SFTP channels"
    start-stop-daemon --stop --pidfile "$pidfile" --signal TERM --retry 5 2>/dev/null
    pkill -f "vchan-socket-proxy.*-m server" 2>/dev/null
    pkill -f "socat.*UNIX-LISTEN:/var/run/safecor/vchan-" 2>/dev/null
    pkill -f "^bwrap.*sftp-server" 2>/dev/null
    rm -f /var/run/safecor/vchan-*.pid /var/run/safecor/socat-*.pid /var/run/safecor/vchan-*.sock
    eend 0
}
