pkgname=safecor-sys-usb
pkgver=2.0
pkgrel=0
pkgdesc="Safecor - USB proxy virtual machine"
url="https://www.alefbet.net/"
arch="all"
license="MIT"
depends="safecor-lib eudev socat xe-guest-utilities fuse-archive fuse3 doas coreutils ntfs-3g xen openssh-sftp-server"
makedepends="python3-dev py3-build py3-installer git"
builddir="$srcdir/$pkgname-$pkgver"
checkdepends=""
install="$pkgname.post-install"
subpackages=""
replaces="mdev-conf alpine-baselayout-data fuse-common"
options="!check"  # no tests provided
source="modules
 safecor-sys-usb-controller.initd
 notify-disk-added.py
 notify-disk-removed.py
 mdev-usb-storage.sh
 99-usbdisks.rules
 99-usbserial.rules
 safecor-sys-usb-controller.py
 create-tty-tunnel.sh
 hardening.sh
 fuse.conf
 doas-svc-sys-usb-controller.conf
 safecor-vchan-sftp.initd
 "

CONFDIR="/etc/safecor"
ROOTDIR="/usr/lib/safecor"
BINDIR="$ROOTDIR/bin"

package() {
    install -D -m644 "$srcdir"/modules "$pkgdir"/etc/modules

    # Scripts
    install -D -m644 "$srcdir"/notify-disk-added.py "$pkgdir"/$BINDIR/notify-disk-added.py
    install -D -m644 "$srcdir"/notify-disk-removed.py "$pkgdir"/$BINDIR/notify-disk-removed.py
    install -D -m755 "$srcdir"/mdev-usb-storage.sh "$pkgdir"/$BINDIR/mdev-usb-storage.sh
    install -D -m755 "$srcdir"/create-tty-tunnel.sh "$pkgdir"/$BINDIR/create-tty-tunnel.sh    

    # Configuration
    install -D -m644 "$srcdir"/99-usbdisks.rules "$pkgdir"/etc/udev/rules.d/99-usbdisks.rules
    install -D -m644 "$srcdir"/99-usbserial.rules "$pkgdir"/etc/udev/rules.d/99-usbserial.rules
    install -D -m755 "$srcdir"/safecor-sys-usb-controller.initd "$pkgdir"/etc/init.d/safecor-sys-usb-controller
    install -D -m644 "$srcdir"/safecor-sys-usb-controller.py "$pkgdir"/$BINDIR/safecor-sys-usb-controller.py    
    install -D -m755 "$srcdir"/fuse.conf "$pkgdir"/etc/fuse.conf

    # Security
    install -D -m755 "$srcdir"/hardening.sh "$pkgdir"/usr/lib/safecor/bin/hardening.sh
    install -D -m644 "$srcdir"/doas-svc-sys-usb-controller.conf "$pkgdir"/etc/doas.d/doas-svc-sys-usb-controller.conf

    # Direct mount (vchan SFTP)
    install -D -m755 "$srcdir"/safecor-vchan-sftp.initd "$pkgdir"/etc/init.d/safecor-vchan-sftp
}

