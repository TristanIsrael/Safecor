82bfe2b01c1ef2e75936cbcf9fea9b44c9dfbc756b4cf3680ceaee8adf049bb2fa9f7ffe0ed107e417d2a07e6d32d0716756fb6b6cf64635fef342c3a2b8478a  show-splash.sh
1203a6251c22978dad406bf718bce798d0518a76992416a86b643f524acb234eb3c87b0fde08ac40d6bca8759566f7ba1ee25cf8269e731b96064fd5b05be12f  hide-splash.sh
"
