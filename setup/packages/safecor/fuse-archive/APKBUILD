pkgname=fuse-archive
pkgver=1.18
pkgrel=0
pkgdesc="Google's FUSE file system for archives and compressed files"
url="https://github.com/google/fuse-archive"
arch="x86_64"
license="Apache-2.0"
depends="libarchive lz4-libs zstd-libs libbz2 zlib xz-libs fuse3-libs"
makedepends="boost-dev fuse3-libs fuse3-dev libarchive-dev pkgconf build-base make pandoc"
checkdepends=""
subpackages=""
source="fuse-archive.tar.gz::https://github.com/google/fuse-archive/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir"/fuse-archive-$pkgver
options="!check" # Checks require the installation of the fuse kernel module

subpackages="$pkgname-doc"

prepare() {
    tar xvzf "$srcdir/fuse-archive.tar.gz"
}

build() {
	cd "$srcdir/fuse-archive-$pkgver"
    make
}

package() {
	cd "$srcdir/fuse-archive-$pkgver"
    make install DESTDIR="$pkgdir"
}

sha512sums="
2430b2a0defa1a068670e4c4bf2994c6e13fb0179713bf95259005b1297d7cefdf75d448c43f655e6e0e328731393adb9dcc5158c24fe4b3ddec184353e9bc1f  fuse-archive.tar.gz
"
