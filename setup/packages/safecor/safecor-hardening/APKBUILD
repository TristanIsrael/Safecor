# Contributor:
# Maintainer: Tristan Israël <tristan.israel@alefbet.net>
# 
# This package provides hardening rules that must be applied explicitely
# by starting the "hardening" service
#
pkgname=safecor-hardening
pkgver=1.3
pkgrel=0
pkgdesc="Safecor - Hardening for Safecor Domains"
url="https://www.alefbet.net/"
arch="noarch"
license="MIT"
depends=""
makedepends=""
builddir="$srcdir/$pkgname-$pkgver"
checkdepends=""
install="$pkgname.post-install"
subpackages=""
replaces=""
options="!check"  # no tests provided
source="
hardening.sh
hardening.initd
"

package() {
    install -D -m755 "$srcdir"/hardening.sh "$pkgdir"/usr/lib/safecor/bin/hardening.sh
    install -D -m755 "$srcdir"/hardening.initd "$pkgdir"/etc/init.d/hardening
}

sha512sums="
3a1ce34ad194b044ec72a45b6e78a47507388b9370880300f41145b7fb1ef2d95bcae6498ac9093e2217dbfe76673e9faf33f3a0bf8ccd5da2a8322835d37558  hardening.sh
"
