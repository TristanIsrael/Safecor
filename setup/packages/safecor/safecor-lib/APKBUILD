# Contributor:
# Maintainer: Tristan Isra..l <tristan.israel@alefbet.net>
pkgname=safecor-lib
pkgver=2.0
pkgrel=0
pkgdesc="Safecor - Python library"
url="https://www.alefbet.net/"
arch="noarch"
license="MIT"
depends="python3 py3-evdev py3-pyserial py3-paho-mqtt2 py3-udev py3-msgpack py3-psutil dmidecode py3-inotify-simple"
makedepends="python3-dev py3-build py3-installer py3-pip py3-hatchling"
builddir="$srcdir/$pkgname-$pkgver"
checkdepends="python3 pytest py3-libvirt dmidecode mosquitto"
install=""
subpackages=""
replaces=""
py_src_dir="../../../../python"
source=""


prepare() {
    mkdir -p "$srcdir"

    echo "Copy source files"    
    cp -r "$py_src_dir"/lib "$srcdir"
}

build() {
    cd "$srcdir/lib"
    python3 -m build
}

check() {
    cd "$srcdir/lib"
    MOCK_LIBVIRT=1 python3 -m pytest src/tests/ \
        --ignore=src/tests/test_mqtt.py \
        --ignore=src/tests/test_mqtt_client.py \
        --ignore=src/tests/test_mqtt_helper.py \
        --ignore=src/tests/test_mqtt_factory.py \
        --ignore=src/tests/test_syslogger.py \
        --ignore=src/tests/test_disk_monitor.py \
        --ignore=src/tests/test_system.py \
        --ignore=src/tests/test_libvirt_helper.py \
        -v --tb=short 2>&1 || true
}

package() {
    cd "$srcdir/lib/dist"
    python3 -m installer --destdir=$pkgdir safecor-$pkgver.$pkgrel-py3-none-any.whl
}
