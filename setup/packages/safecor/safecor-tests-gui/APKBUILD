# Contributor:
# Maintainer: Tristan Israël <tristan.israel@alefbet.net>
pkgname=safecor-tests-gui
pkgver=1.2
pkgrel=0
pkgdesc="Safecor - Test tool GUI"
url="https://www.alefbet.net/"
arch="noarch"
license="MIT"
depends="safecor-gui-base safecor-lib python3 py3-pyside6 fontconfig freetype font-roboto qt6-qt5compat fontconfig freetype font-roboto"
makedepends="python3-dev py3-build py3-installer git"
builddir="$srcdir/$pkgname-$pkgver"
checkdepends=""
install="$pkgname.post-install"
subpackages=""
replaces=""
options="!check"  # no tests provided
gitbranch="main"
source="
$pkgname.zip::https://github.com/TristanIsrael/Safecor/archive/refs/heads/$gitbranch.zip
tests.initd
"

prepare() {
    default_prepare   
}

build() {
    cd "$gitrepo-$gitbranch"/python/tests
    python3 -m build
}

package() {
    mkdir -p "$pkgdir/usr/lib/safecor"
    cd "$srcdir/$gitrepo-$gitbranch/python/tests/dist"    
    tar xvzf *.tar.gz -C "$pkgdir/usr/lib/safecor"
    cd "$pkgdir/usr/lib/safecor"
    ln -s "tests-$pkgver" tests    

    install -D -m755 "$srcdir"/tests.initd "$pkgdir/etc/init.d/tests"
}
sha512sums="
