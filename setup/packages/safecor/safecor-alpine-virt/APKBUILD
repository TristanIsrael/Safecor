replaces=""
options="!check"  # no tests provided
source="
https://gitlab.alpinelinux.org/alpine/aports/-/archive/v$pkgver.$pkgrel/aports-v$pkgver.$pkgrel.tar.bz2
"
modules="
CONFIG_HID_GENERIC=m
CONFIG_HID_MULTITOUCH=m
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_USB_HID=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_KEYSPAN=m
CONFIG_USB_ACM=m
"

prepare() {
    # We will build 2 packages: linux-safecor-virt (linux-lts) and xtables-addons-safecor-virt (xtables-addons-lts)

    #####
    # Package linux-safecor-virt
    ##### 

    # Prepare config files
    cd "$srcdir/aports-v$pkgver.$pkgrel/main/linux-lts"
    cp "virt.$arch.config" "safecor-virt.$arch.config"

    # We remove the configs we don't want 
    sed -i '/[[:space:]]*lts\..*\.config/d' APKBUILD
    sed -i '/virt\..*\.config/ {/virt\.x86_64\.config/!d}' APKBUILD

    # We replace virt config with our own
    sed -i 's/virt\.x86_64\.config/safecor-virt.x86_64.config/g' APKBUILD

    abuild checksum     
    abuild clean 
    abuild deps
    abuild fetch 
    abuild unpack 
    abuild prepare    

    # We add the modules we want
    echo "$modules" >> "safecor-virt.$arch.config"

    ##### 
    # Package xtables-addons-safecor-virt 
    #####

    # Patch APKBUILD
    cd "$srcdir/aports-v$pkgver.$pkgrel/main/xtables-addons-lts" 
    sed -i \
    -e 's|^pkgname=xtables-addons-lts$|pkgname=xtables-addons-safecor-virt|' \
    -e 's|^_name=${pkgname%-*}$|_name=xtables-addons|' \
    -e 's|^_flavor=${pkgname##*-}$|_flavor=safecor-virt|' \
    APKBUILD

    # Build the package
    abuild -r
}

build() {
    # Now we build the kernel and modules

    #####
    # Package linux-safecor-virt
    ##### 
    cd "$srcdir/aports-v$pkgver.$pkgrel/main/linux-lts"

    FLAVOR=safecor-virt abuild build -r

    # At this stage we have a kernel in $srcdir/aports-v$pkgver.$pkgrel/main/linux-lts/pkg/linux-safecor-virt/boot
    # but it misses the modloop that is built in the package.

    ##### 
    # Package xtables-addons-safecor-virt 
    #####
    cd "$srcdir/aports-v$pkgver.$pkgrel/main/xtables-addons-lts" 

    abuild -r
}

