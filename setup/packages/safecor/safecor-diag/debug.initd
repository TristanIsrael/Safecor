#!/sbin/openrc-run

name="debug"

depend() {
    need hwdrivers
}

start() {
    ebegin "Start debug console"

    start-stop-daemon --start --make-pidfile --exec /usr/lib/safecor/bin/start-debug.sh --pidfile /var/run/$name.pid --background

    eend $?
}

stop() {
    ebegin "Stop debug console"

    kill -9 $(cat /var/run/$name.pid)

    eend $?
}