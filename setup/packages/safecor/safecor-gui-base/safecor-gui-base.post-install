#!/bin/sh

echo "" >> /etc/profile
echo "export DISPLAY=:0" >> /etc/profile
export DISPLAY=:0

rc-service udev start
rc-service udev-postmount start
rc-service udev-trigger start

echo "**** Setting timezone ****"
ln -sf /usr/share/zoneinfo/Europe/Paris /etc/localtime
echo "Europe/Paris" > /etc/timezone

echo "**** Resizing shared memory"
mount -o remount,size=1M /dev/shm
mount -o remount,size=1M /run
mount -o remount,size=100% /

#/usr/lib/safecor/bin/hardening.sh

echo "Safecor GUI base package installed"

exit 0