#!/sbin/openrc-run
# Start/stop the DirectMountManager process in a DomU.
#
# Copyright (c) 2024-2026, Tristan Israël
# Safecor Licence — see python/lib/LICENCE.md

name="direct-mount"
pidfile="/var/run/safecor-direct-mount.pid"

depend() {
    after network
}

start() {
    ebegin "Setting up direct USB mount"
    modprobe fuse 2>/dev/null
    start-stop-daemon --start --background --make-pidfile \
        --pidfile "$pidfile" \
        --exec /usr/bin/python3 \
        -- /usr/lib/safecor/scripts/start-direct-mount.py
    eend $?
}

stop() {
    ebegin "Stopping direct USB mount"
    start-stop-daemon --stop --pidfile "$pidfile" --signal TERM
    sleep 2
    fusermount -u /media/usb 2>/dev/null
    eend 0
}
