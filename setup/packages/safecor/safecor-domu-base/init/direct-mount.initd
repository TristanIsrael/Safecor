#!/sbin/openrc-run
# Start/stop the DirectMountManager process in a DomU.
#
# Copyright (c) 2024-2026, Tristan Israël
# Safecor Licence — see python/lib/LICENCE.md

name="direct-mount"
pidfile="/var/run/safecor-direct-mount.pid"

depend() {
    after network
}

start() {
    ebegin "Setting up direct USB mount"
    modprobe fuse 2>/dev/null
    # The manager mirrors its diagnostics on standard error. By default they
    # are discarded to keep the boot console clean; start
    # /usr/lib/safecor/bin/start-direct-mount.py manually in the domain
    # console to see them.
    start-stop-daemon --start --background --make-pidfile \
        --pidfile "$pidfile" \
        --exec /bin/sh \
        -- -c 'exec /usr/bin/python3 /usr/lib/safecor/bin/start-direct-mount.py >/dev/null 2>&1'
    eend $?
}

stop() {
    ebegin "Stopping direct USB mount"
    start-stop-daemon --stop --pidfile "$pidfile" --signal TERM
    sleep 2
    fusermount -u /media/usb 2>/dev/null
    eend 0
}
