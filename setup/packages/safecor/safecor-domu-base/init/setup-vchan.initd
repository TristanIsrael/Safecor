#!/sbin/openrc-run
# Start/stop the vchan clients (msg, input, tty) in a DomU.
#
# The msg channel is a local mosquitto broker bridged upstream over the
# vchan (local broker + socat); the input and tty channels are direct
# vchan-socket-proxy clients. All the daemons are detached (one pidfile
# per process, created by setup-vchan.sh); this service only supervises
# their lifecycle.
#
# Copyright (c) 2024-2026, Tristan Israël
# Safecor Licence — see python/lib/LICENCE.md

name="setup-vchan"

depend() {
    after network
}

start() {
    ebegin "Starting vchan clients"
    /usr/lib/safecor/bin/setup-vchan.sh || true
    eend 0 # Always succeed otherwise it will break the package build
}

stop() {
    ebegin "Stopping vchan clients"
    start-stop-daemon --stop --pidfile /var/run/safecor/mosquitto-domu.pid --signal TERM 2>/dev/null
    start-stop-daemon --stop --pidfile /var/run/safecor/vchan-msg-socat.pid --signal TERM 2>/dev/null
    start-stop-daemon --stop --pidfile /var/run/safecor/vchan-input.pid --signal TERM 2>/dev/null
    start-stop-daemon --stop --pidfile /var/run/safecor/vchan-tty.pid --signal TERM 2>/dev/null
    rm -f /var/run/safecor/mosquitto-domu.pid /var/run/safecor/vchan-msg-socat.pid \
          /var/run/safecor/vchan-input.pid /var/run/safecor/vchan-tty.pid
    rm -f /var/run/safecor/mosquitto.conf
    eend 0
}
