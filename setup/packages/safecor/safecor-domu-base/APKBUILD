# Contributor:
# Maintainer: Tristan Israël <tristan.israel@alefbet.net>
pkgname=safecor-domu-base
pkgver=1.2
pkgrel=0
pkgdesc="Safecor - Base package for business domain"
url="https://www.alefbet.net/"
arch="noarch"
license="MIT"
depends="safecor-syslog safecor-hardening shadow"
makedepends=""
builddir="$srcdir/$pkgname-$pkgver"
checkdepends=""
install="$pkgname.post-install"
subpackages=""
replaces=""
options="!check"  # no tests provided
source="
color_prompt.sh
motd"

package() {
    mkdir -p "$pkgdir"/usr/lib/safecor/etc

    install -D -m644 "$srcdir"/color_prompt.sh "$pkgdir"/etc/profile.d/color_prompt.sh
    install -D -m755 "$srcdir"/motd "$pkgdir/etc/motd"
}
