pkgname=safecor-domu-base
pkgver=2.0
pkgrel=0
pkgdesc="Safecor - Base package for business domain"
url="https://www.alefbet.net/"
arch="all"
license="MIT"
depends="openrc shadow sshfs fuse3 xen"
makedepends=""
builddir="$srcdir/$pkgname-$pkgver"
checkdepends=""
install="$pkgname.post-install"
subpackages=""
replaces=""
options="!check"  # no tests provided
source=""

package() {
    mkdir -p "$pkgdir"/usr/lib/safecor/etc
    echo "$pkgname" >> "$pkgdir"/usr/lib/safecor/etc/installed
    mkdir -p "$pkgdir"/usr/lib/safecor/bin
    mkdir -p "$pkgdir"/etc/init.d
    install -m 755 scripts/setup-direct-mount.sh "$pkgdir"/usr/lib/safecor/bin/setup-direct-mount.sh
    install -m 755 scripts/start-direct-mount.py "$pkgdir"/usr/lib/safecor/bin/start-direct-mount.py
    install -m 755 scripts/setup-vchan.sh "$pkgdir"/usr/lib/safecor/bin/setup-vchan.sh
    install -m 755 init/direct-mount.initd "$pkgdir"/etc/init.d/direct-mount
    install -m 755 init/setup-vchan.initd "$pkgdir"/etc/init.d/setup-vchan
}
