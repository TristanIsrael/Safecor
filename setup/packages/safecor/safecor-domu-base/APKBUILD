pkgname=safecor-domu-base
pkgver=2.0
pkgrel=0
pkgdesc="Safecor - Base package for business domain"
url="https://www.alefbet.net/"
arch="noarch"
license="MIT"
depends="shadow sshfs fuse3 xen"
makedepends=""
builddir="$srcdir/$pkgname-$pkgver"
checkdepends=""
install="$pkgname.post-install"
subpackages=""
replaces=""
options="!check"  # no tests provided
source=""

package() {
    mkdir -p "$pkgdir"/usr/lib/safecor/etc
    echo "$pkgname" >> "$pkgdir"/usr/lib/safecor/etc/installed
    mkdir -p "$pkgdir"/usr/lib/safecor/scripts
    mkdir -p "$pkgdir"/etc/init.d
    install -m 755 scripts/setup-direct-mount.sh "$pkgdir"/usr/lib/safecor/scripts/
    install -m 755 scripts/start-direct-mount.py "$pkgdir"/usr/lib/safecor/scripts/
    install -m 755 init/direct-mount.initd "$pkgdir"/etc/init.d/
}
