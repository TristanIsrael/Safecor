#!/bin/sh

host=$(hostname)

logger -t "Safecor/$host/safecor-domu-base" -p user.info "Create the safecor group"
addgroup -g 2000 safecor || true

logger -t "Safecor/$host/safecor-domu-base" -p user.info "Set permissions on /mnt/storage"
if [ -d "/mnt/storage" ]; then
    chgrp safecor /mnt/storage
    chmod 770 /mnt/storage
fi

logger -t "Safecor/$host/safecor-domu-base" -p user.info "Mount temp disk on /tmp if required"
mount LABEL=TMPFILE /tmp || true
rmdir /var/tmp
ln -s /tmp /var/tmp
chmod 777 /tmp

logger -t "Safecor/$host/safecor-domu-base" -p user.info "Activate swap if needed"
if [ -e /dev/xvdf1 ]; then
    mkswap /dev/xvdf1
    swapon /dev/xvdf1
fi

# Start the hardening
logger -t "Safecor/$host/safecor-domu-base" -p user.info "Start the hardening service"
rc-service hardening start