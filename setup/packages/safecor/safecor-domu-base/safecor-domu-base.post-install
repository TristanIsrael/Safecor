#!/bin/sh

echo "Create the safecor group"
addgroup -g 2000 safecor || true

echo "Set permissions on /mnt/storage"
if [ -d "/mnt/storage" ]; then
    chgrp safecor /mnt/storage
    chmod 770 /mnt/storage
fi

echo "Mount temp disk on /tmp if required"
mount LABEL=TMPFILE /tmp || true
rmdir /var/tmp
ln -s /tmp /var/tmp
chmod 777 /tmp

echo "Activate swap if needed"
if [ -e /dev/xvdf1 ]; then
    mkswap /dev/xvdf1
    swapon /dev/xvdf1
fi