#!/sbin/openrc-run
# Copyright (c) 2024-2026, Tristan Israël
# Safecor Licence — see python/lib/LICENCE.md

name="create-vchan-tunnels"
logfile="/var/log/safecor/vchan-tunnels.log"
user="svc-vchan-tunnels"

depend() {
    after mosquitto
    after orchestrator
}

start() {
    ebegin "Create vchan tunnels"

    # The vchan servers (running as $user) need read/write access to the Xen
    # device nodes, which are created by the kernel when the modules are
    # loaded. Under Xen 4.19 these nodes live in /dev/xen/:
    #   gntalloc  grant allocator: the server allocates the ring page from it
    #   gntdev    grant table: the client maps the shared ring page through it
    #   evtchn    event channels: used by both the server and the client
    #
    # The udev rule 99-safecor-xen.rules already applies the group and mode
    # when a node is created; udev creates the nodes asynchronously after the
    # module load, so wait for them to appear and apply the permissions as a
    # fallback (idempotent if udev already did it).
    modprobe xen_gntdev
    modprobe xen_gntalloc
    modprobe xen_evtchn
    for i in $(seq 1 20); do
        [ -e /dev/xen/gntdev ] && [ -e /dev/xen/evtchn ] && [ -e /dev/xen/gntalloc ] && break
        sleep 0.5
    done
    for node in /dev/xen/gntdev /dev/xen/evtchn /dev/xen/gntalloc; do
        if [ -e "$node" ]; then
            chgrp safecor "$node"
            chmod 660 "$node"
            logger -t "Safecor/create-vchan-tunnels" -p user.info "Device node ready: $node"
        else
            logger -t "Safecor/create-vchan-tunnels" -p user.err "Device node missing after module load: $node"
        fi
    done

    # The msg servers must also be able to connect to the Mosquitto UNIX
    # listeners of /tmp (one per domain).
    addgroup svc-vchan-tunnels mosquitto 2>/dev/null || true
    chmod g+w /tmp/mqtt-*.sock 2>/dev/null || true

    if grep -iq "DEBUG=ON" "/proc/cmdline"; then
        rm -f $logfile
        start-stop-daemon --start --make-pidfile --exec /usr/bin/python3 --pidfile /var/run/$name.pid --background --stdout $logfile --stderr $logfile --user $user -- -u /usr/lib/safecor/bin/create-vchan-tunnels.py
    else
        start-stop-daemon --start --make-pidfile --exec /usr/bin/python3 --pidfile /var/run/$name.pid --background --user $user -- /usr/lib/safecor/bin/create-vchan-tunnels.py
    fi

    eend $?
}

stop() {
    ebegin "Destroy vchan tunnels"

    kill -9 $(cat /var/run/$name.pid)
    pkill -f "vchan-socket-proxy.*-m server" 2>/dev/null

    eend $?
}
