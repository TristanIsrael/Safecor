#!/sbin/openrc-run

name="safecor-core-init"

depend() {
    after syslog
}

start() {
    ebegin "Finalizing Safecor initialization"

    mount -o remount,size=5% /dev/shm
    mount -o remount,size=1M /run
    mount -o remount,size=95% /

    apk update
    apk upgrade
    apk add

    eend $?
}

stop() {
    ebegin ""
    eend $?
}
