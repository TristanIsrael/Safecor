#!/sbin/openrc-run

name="safecor-core-init"

depend() {
    after syslog
}

start() {
    ebegin "Finalizing Safecor initialization"

    # Remount special devices
    mount -o remount,size=5% /dev/shm
    mount -o remount,size=1M /run
    mount -o remount,size=95% /

    # Create safecor group
    addgroup -g 2000 safecor

    # Set permissions for shares
    mkdir -p /mnt/storage
    mkdir -p /mnt/packages
    mkdir -p /mnt/system
    chown root:safecor /mnt/storage
    chmod 770 /mnt/storage
    chmod 700 /mnt/packages
    chmod 700 /mnt/system

    apk update
    apk upgrade
    apk add

    eend $?
}

stop() {
    ebegin ""
    eend $?
}
