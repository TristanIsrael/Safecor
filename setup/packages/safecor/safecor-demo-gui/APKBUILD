# Contributor:
# Maintainer: Tristan Israël <tristan.israel@alefbet.net>
pkgname=safecor-demo-gui
pkgver=1.0
pkgrel=1
pkgdesc="Safecor - Demonstration application GUI"
url="https://www.alefbet.net/"
arch="noarch"
license="MIT"
depends="safecor-lib safecor-gui-base python3 py3-pyside6 py3-psutil py3-humanize fontconfig freetype font-roboto"
makedepends="python3-dev py3-build py3-installer git"
builddir="$srcdir/$pkgname-$pkgver"
checkdepends=""
install="$pkgname.post-install"
subpackages=""
replaces=""
options="!check"  # no tests provided
gitbranch="main"
py_src_dir="../../../../python"
source="
start-gui.initd
"

prepare() {
    mkdir -p "$builddir"
    mkdir -p "$srcdir"

    echo "Copy source files"
    cp -r "$py_src_dir"/demo "$srcdir"
}

build() {
    cd "$srcdir/demo"
    python3 -m build
}

package() {
    cd "$srcdir/demo/dist"
    mkdir -p "$pkgdir/usr/lib/safecor"
    tar xvzf demo-$pkgver.tar.gz -C "$pkgdir/usr/lib/safecor"
    cd "$pkgdir/usr/lib/safecor"
    ln -s "demo-$pkgver" demo

    install -D -m755 "$srcdir"/start-gui.initd "$pkgdir"/etc/init.d/start-gui
}

sha512sums="
4c61bffd6da9df886b6734fe6478b9a68aec94e65f13052ce97454210cfad7b2d95e1462cdf1b8f3f1b0521d1be238cd744d6f6aa22e4d2343fe106078176ad1  start-gui.initd
"
